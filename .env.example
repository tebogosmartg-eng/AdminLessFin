# Frontend (required) — copy to .env and fill in from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Private Beta Product Analytics
# Comma-separated emails allowed to view /admin/beta-analytics dashboard:
# VITE_BETA_ANALYTICS_ALLOWLIST=ops@yourcompany.com,founder@yourcompany.com
# Edge Function secret (same list): BETA_ANALYTICS_ALLOWLIST=ops@yourcompany.com
# Opt-in: set true only when product-analytics edge function is deployed.
# VITE_PRODUCT_ANALYTICS_ENABLED=true

# Financial Statements — V6.5.1 Internal Preview (navigation recovery)
# Board-approved Internal Release: set these true so the sidebar group appears.
# Kill-switch: VITE_EFS_NAV_SIDEBAR=false hides nav without redeploying UI.
VITE_EFS_MODULE=true
VITE_EFS_WORKSPACE_UI=true
VITE_EFS_NAV_SIDEBAR=true
VITE_EFS_SNAPSHOT_PIPELINE=true
# Developer / Internal console (Reporting Snapshot pipeline). Keep false for accountants.
# VITE_EFS_DEVELOPER_TOOLS=false
VITE_EFS_WORKING_PAPERS=true
VITE_EFS_DISCLOSURES=true
VITE_EFS_VALIDATION=true
VITE_EFS_REVIEW_WORKFLOW=true
VITE_EFS_PUBLICATION=true
# V11.0 — Accounts Production document workspace (Document tab). Default ON when module enabled.
VITE_EFS_DOCUMENT_WORKSPACE=true
# V7.0.0 — Canonical Trial Balance / TB Import / Mapping (Financial Reporting Platform)
VITE_EFS_FRP_CANONICAL_TB=true
# Accountants / Internal Testers (company role member) — comma-separated emails:
# VITE_EFS_ALLOWLIST=accountant@example.com,tester@example.com

# Financial Close Platform — EFCP V6.8.0 (additive; accounting readiness before AFS)
VITE_EFCP_MODULE=true
VITE_EFCP_WORKSPACE_UI=true
VITE_EFCP_NAV_SIDEBAR=true
# VITE_EFCP_ALLOWLIST=accountant@example.com
#
# Deferred (forced OFF in code — reserved for future public release board):
# VITE_EFS_XBRL=false
# VITE_EFS_AI_ASSISTANCE=false
#
# Edge Function secrets (Dashboard → Edge Functions → Secrets):
#   EFS_MODULE=true
#   EFCP_SILENT_BACKENDS=true
#   EFCP_MODULE=true
#   EFS_PUBLICATION=true
#   EFS_FRP_CANONICAL_TB=true

# Edge function secrets are configured in Supabase Dashboard → Edge Functions → Secrets
# (not in this file). Required for all data functions:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Optional (email / AI features):
#   RESEND_API_KEY
#   RESEND_DOMAIN
#   OPENAI_API_KEY
#
# Database migrations (local CLI only — never commit):
#   SUPABASE_DB_PASSWORD=your-database-password
#
# Payroll E2E certification (staging only):
#   E2E_EMAIL=
#   E2E_PASSWORD=
#
# EAM V16.5 enterprise certification tenant (required for npm run certify:eam):
#   EAM_CERT_COMPANY_ID=3cbfd4eb-a095-43f3-837a-0b4f1e2c1752
# Or: EAM_CERT_COMPANY_NAME=Spaceman
# Optional alias: E2E_COMPANY_ID (same UUID as above)
