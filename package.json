{
  "name": "adminless-fin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:legislation": "npx --yes tsx -e \"import { verifyLegislation } from './src/statutory/index.ts'; const r = verifyLegislation(); console.log(JSON.stringify(r, null, 2)); if (!r.ok) process.exit(1);\"",
    "verify:statutory": "npm run verify:legislation && npx --yes tsx -e \"import { runStatutoryVerification } from './src/lib/statutoryPayrollEngine/verify.ts'; const r = runStatutoryVerification(); console.log(JSON.stringify(r, null, 2)); process.exit(r.failed > 0 ? 1 : 0);\"",
    "certify:statutory": "npm run verify:legislation && npx --yes tsx -e \"import { runCertificationProgramme, formatProgrammeSummary, certificationGatePassed } from './src/lib/statutoryPayrollEngine/certificationRunner.ts'; const r = runCertificationProgramme(); console.log(formatProgrammeSummary(r)); process.exit(certificationGatePassed(r) ? 0 : 1);\"",
    "certify:statutory:json": "npx --yes tsx -e \"import { runCertificationProgramme } from './src/lib/statutoryPayrollEngine/certificationRunner.ts'; console.log(JSON.stringify(runCertificationProgramme(), null, 2));\"",
    "test": "vitest run",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:payroll": "vitest run && vitest run --config vitest.integration.config.ts",
    "certify:payroll": "npm run test:payroll && npm run certify:statutory",
    "certify:e2e": "npx --yes tsx tests/e2e/run-payroll-live-certification.ts",
    "certify:efs": "npx --yes tsx tests/e2e/run-efs-e2e-certification.ts",
    "certify:business": "npx --yes tsx tests/e2e/run-business-operations-certification.ts",
    "certify:eam": "npx --yes tsx tests/e2e/run-eam-certification.ts",
    "test:eam": "vitest run tests/unit/eam-v164-certification.test.ts",
    "seed:eam": "npx --yes tsx scripts/seed-eam-enterprise.ts",
    "forensics:employee-number": "npx --yes tsx scripts/employeeNumberForensics.ts",
    "apply:employee-number": "node scripts/applyEmployeeNumberEngine.mjs",
    "validate:employee-number": "npx --yes tsx scripts/validateEmployeeNumberEngine.ts",
    "probe:integrations": "npx --yes tsx scripts/integrationProbe.ts",
    "cleanup:validation-employees": "npx --yes tsx scripts/cleanupValidationEmployees.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
